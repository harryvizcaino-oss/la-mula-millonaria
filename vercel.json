{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!assets|test\\.html|privacy-policy\\.html|terms-of-service\\.html|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
